<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RetroMultiTools.Localization"
             x:Class="RetroMultiTools.Views.Browsing.BigPictureModernView"
             Background="#0D0D14"
             Focusable="True">
    <DockPanel>
        <!-- ═══ Top Navigation Bar ═══ -->
        <Border DockPanel.Dock="Top" Background="#14141F" Padding="28,10" ZIndex="5">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: App icon + title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <PathIcon Width="24" Height="24" Foreground="#7C5CFC"
                              Data="M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-10 7H8v3H6v-3H3v-2h3V8h2v3h3v2zm4.5 2c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm4-3c-.83 0-1.5-.67-1.5-1.5S18.67 9 19.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                    <TextBlock Text="{Binding [BigPicture_Title], Source={x:Static loc:LocalizationManager.Instance}}"
                               FontSize="18" FontWeight="Bold" Foreground="#E2E0F0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Search -->
                <Border Grid.Column="1" Background="#1A1A2E" CornerRadius="24" Padding="16,0"
                        Margin="80,0" MaxWidth="540" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="Auto,*">
                        <PathIcon Grid.Column="0" Width="16" Height="16" Foreground="#5A5A7A" Margin="0,0,8,0"
                                  Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                  VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1"
                                 Watermark="{Binding [BigPictureModern_SearchPlaceholder], Source={x:Static loc:LocalizationManager.Instance}}"
                                 FontSize="14" Padding="4,8" Background="Transparent"
                                 BorderThickness="0" Foreground="#E2E0F0"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>

                <!-- Right: Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ComboBox x:Name="SystemFilterCombo" MinWidth="160" FontSize="12"
                              PlaceholderText="{Binding [BigPicture_AllSystems], Source={x:Static loc:LocalizationManager.Instance}}"
                              SelectionChanged="SystemFilterCombo_SelectionChanged"
                              Background="#1A1A2E" Foreground="#E2E0F0"/>
                    <ComboBox x:Name="SortCombo" MinWidth="140" FontSize="12"
                              SelectionChanged="SortCombo_SelectionChanged"
                              Background="#1A1A2E" Foreground="#E2E0F0"/>
                    <ToggleButton x:Name="FavoritesFilterButton" Padding="8,6"
                                  IsCheckedChanged="FavoritesFilterButton_Changed"
                                  Background="#1A1A2E" Foreground="#FFC857">
                        <TextBlock Text="★" FontSize="16"/>
                    </ToggleButton>
                    <Button x:Name="RandomGameButton" Padding="8,6" Background="#1A1A2E" Foreground="#E2E0F0"
                            Click="RandomGameButton_Click" ToolTip.Tip="Random Game">
                        <TextBlock Text="🎲" FontSize="16"/>
                    </Button>
                    <Button x:Name="RescanButton" Padding="8,6" Background="#1A1A2E" Foreground="#E2E0F0"
                            Click="RescanButton_Click" ToolTip.Tip="Rescan">
                        <TextBlock Text="🔄" FontSize="16"/>
                    </Button>
                    <Button x:Name="BrowseFolderButton" Padding="8,6" Background="#1A1A2E" Foreground="#E2E0F0"
                            Click="BrowseFolderButton_Click" ToolTip.Tip="Browse Folder">
                        <TextBlock Text="📂" FontSize="16"/>
                    </Button>
                    <Button x:Name="ExitBigPictureButton" Padding="8,6" Background="#2A1A2E" Foreground="#FF6B8A"
                            Click="ExitBigPictureButton_Click" ToolTip.Tip="Exit Big Picture">
                        <TextBlock Text="✕" FontSize="16" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Status Bar ═══ -->
        <Border DockPanel.Dock="Bottom" Background="#14141F" Padding="28,6">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <ProgressBar x:Name="ScanProgressBar" IsVisible="False" Minimum="0" Maximum="1"
                                 IsIndeterminate="True" Height="3" Foreground="#7C5CFC"/>
                    <TextBlock x:Name="StatusText" Foreground="#7A7A9A" FontSize="12"
                               Text="{Binding [BigPicture_Ready], Source={x:Static loc:LocalizationManager.Instance}}"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1A1A2E" CornerRadius="4" Padding="8,3"
                        Margin="10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="GamepadStatusText" Foreground="#7A7A9A" FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
                <Border Grid.Column="2" Background="#1A1A2E" CornerRadius="4" Padding="8,3"
                        Margin="10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ZoomLevelText" Foreground="#7A7A9A" FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
                <Border Grid.Column="3" Background="#1A1A2E" CornerRadius="4" Padding="8,3"
                        Margin="10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="RomCountText" Foreground="#E2E0F0" FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
                <TextBlock Grid.Column="4" x:Name="HintText" Foreground="#5A5A7A" FontSize="11"
                           VerticalAlignment="Center"
                           Text="{Binding [BigPicture_Hints], Source={x:Static loc:LocalizationManager.Instance}}"/>
            </Grid>
        </Border>

        <!-- ═══ Main Content Area ═══ -->
        <Grid x:Name="MainContentGrid">
            <!-- Layout: Hero (fixed top) + Scrollable Carousel -->
            <Grid RowDefinitions="Auto,*">

                <!-- ── Hero Spotlight Section (stays visible while browsing) ── -->
                <Border Grid.Row="0" x:Name="HeroSection" MinHeight="280" MaxHeight="360"
                        Background="#0D0D14" Padding="0" Margin="0,0,0,4">
                    <Grid>
                        <!-- Background artwork (blurred) -->
                        <Border x:Name="HeroBgBorder" ClipToBounds="True" Opacity="0.25">
                            <Image x:Name="HeroBgImage" Stretch="UniformToFill"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Gradient overlay for readability -->
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Color="#CC0D0D14" Offset="0"/>
                                    <GradientStop Color="#880D0D14" Offset="0.3"/>
                                    <GradientStop Color="#EE0D0D14" Offset="0.85"/>
                                    <GradientStop Color="#FF0D0D14" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Left gradient for text area -->
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,50%" EndPoint="70%,50%">
                                    <GradientStop Color="#DD0D0D14" Offset="0"/>
                                    <GradientStop Color="#000D0D14" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Hero Content -->
                        <Grid ColumnDefinitions="*,Auto" Margin="48,24,48,20">
                            <!-- Left: Game Info -->
                            <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center"
                                        MaxWidth="700" HorizontalAlignment="Left">
                                <!-- System badge -->
                                <Border x:Name="HeroSystemBadge" Background="#7C5CFC"
                                        CornerRadius="14" Padding="14,4"
                                        HorizontalAlignment="Left" Opacity="0.9">
                                    <TextBlock x:Name="HeroSystemText" FontSize="12" FontWeight="Bold"
                                               Foreground="#FFFFFF"/>
                                </Border>

                                <!-- Game Title -->
                                <TextBlock x:Name="HeroTitle" FontSize="36" FontWeight="ExtraBold"
                                           Foreground="#FFFFFF" TextWrapping="Wrap"
                                           MaxLines="2" LineHeight="42"/>

                                <!-- Meta info row -->
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <TextBlock x:Name="HeroRating" Foreground="#FFC857" FontSize="15"/>
                                    <TextBlock x:Name="HeroPlayTime" Foreground="#9A9ABE" FontSize="13"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HeroPlayCount" Foreground="#9A9ABE" FontSize="13"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HeroSize" Foreground="#7A7A9A" FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HeroValid" Foreground="#7A7A9A" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                    <Button x:Name="HeroLaunchButton"
                                            Click="LaunchButton_Click"
                                            Padding="24,10" FontSize="15" FontWeight="Bold"
                                            Background="#7C5CFC" Foreground="#FFFFFF"
                                            CornerRadius="24">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="▶" FontSize="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding [BigPicture_Launch], Source={x:Static loc:LocalizationManager.Instance}}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="HeroLaunchMameButton"
                                            Click="LaunchMameButton_Click"
                                            Padding="16,10" FontSize="13" FontWeight="SemiBold"
                                            Background="#2A2A40" Foreground="#FFC857"
                                            CornerRadius="24" IsVisible="False">
                                        <TextBlock Text="{Binding [BigPicture_LaunchMame], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                    </Button>
                                    <Button x:Name="HeroLaunchMednafenButton"
                                            Click="LaunchMednafenButton_Click"
                                            Padding="16,10" FontSize="13" FontWeight="SemiBold"
                                            Background="#2A2A40" Foreground="#6BE3A0"
                                            CornerRadius="24" IsVisible="False">
                                        <TextBlock Text="{Binding [BigPicture_LaunchMednafen], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                    </Button>
                                    <Button x:Name="HeroFavoriteButton"
                                            Click="FavoriteButton_Click"
                                            Padding="12,10" FontSize="15"
                                            Background="#2A2A40" Foreground="#FFC857"
                                            CornerRadius="24"/>
                                    <Button x:Name="HeroInfoButton"
                                            Click="InfoButton_Click"
                                            Padding="12,10" FontSize="13"
                                            Background="#2A2A40" Foreground="#9A9ABE"
                                            CornerRadius="24"
                                            Content="ℹ"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: Box Art -->
                            <Border Grid.Column="1" CornerRadius="12" ClipToBounds="True"
                                    Width="180" Height="250" Margin="24,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="#1A1A2E">
                                <Grid>
                                    <Image x:Name="HeroBoxArt" Stretch="UniformToFill"/>
                                    <TextBlock x:Name="HeroBoxArtPlaceholder" FontSize="56" FontWeight="Bold"
                                               Foreground="#2A2A40" Opacity="0.5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ── Scrollable Carousel Rows ── -->
                <ScrollViewer Grid.Row="1" x:Name="MainScroll"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CarouselContainer" Spacing="8" Margin="0,0,0,24"/>
                </ScrollViewer>
            </Grid>

            <!-- Empty State -->
            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="20" IsVisible="True">
                <Border Background="#1A1A2E" CornerRadius="24" Padding="48,40"
                        HorizontalAlignment="Center">
                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                        <PathIcon Width="72" Height="72" Foreground="#3A3A5A"
                                  Data="M1 3h6l2 2h10v12H1V3zm2 2v10h14V7H8.17L6.17 5H3z"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding [BigPictureModern_EmptyLibrary], Source={x:Static loc:LocalizationManager.Instance}}"
                                   FontSize="18" Foreground="#7A7A9A"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="400"/>
                        <Button Content="{Binding [BigPicture_SelectFolder], Source={x:Static loc:LocalizationManager.Instance}}"
                                Click="BrowseFolderButton_Click"
                                HorizontalAlignment="Center"
                                Padding="28,12" FontSize="15" FontWeight="SemiBold"
                                Background="#7C5CFC" Foreground="#FFFFFF"
                                CornerRadius="24"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══ Help Overlay ═══ -->
            <Border x:Name="HelpOverlay"
                    Background="#EE0D0D14" IsVisible="False"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Padding="0" ZIndex="10">
                <Border Background="#1A1A2E" CornerRadius="16" Padding="44,36"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="780" BorderBrush="#2A2A40" BorderThickness="1">
                    <StackPanel Spacing="20">
                        <TextBlock x:Name="HelpOverlayTitle" FontSize="22" FontWeight="Bold"
                                   Foreground="#E2E0F0" HorizontalAlignment="Center"/>
                        <Border Background="#2A2A40" Height="1" Margin="0,0,0,4"/>
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="HelpKeyboardHeader"
                                       Text="{Binding [BigPicture_HelpKeyboardHeader], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" Foreground="#7C5CFC"
                                       FontWeight="SemiBold" Margin="0,0,24,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="HelpGamepadHeader"
                                       Text="{Binding [BigPicture_HelpControllerHeader], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" Foreground="#FFC857"
                                       FontWeight="SemiBold" Margin="24,0,0,8" IsVisible="False"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="← → ↑ ↓" FontSize="14" Foreground="#7C5CFC" FontWeight="SemiBold" Margin="0,4,24,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HelpNav" FontSize="14" Foreground="#E2E0F0" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="HelpGamepadNav"
                                       Text="{Binding [BigPicture_HelpPadNav], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" Foreground="#FFC857" Margin="24,4,0,4" IsVisible="False"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [BigPicture_HelpKeyLaunch], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="14" Foreground="#7C5CFC" FontWeight="SemiBold" Margin="0,4,24,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="HelpLaunch" FontSize="14" Foreground="#E2E0F0" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="HelpGamepadLaunch" Text="A" FontSize="13" Foreground="#FFC857" Margin="24,4,0,4" IsVisible="False"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="F" FontSize="14" Foreground="#7C5CFC" FontWeight="SemiBold" Margin="0,4,24,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="HelpFav" FontSize="14" Foreground="#E2E0F0" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="HelpGamepadFav" Text="Y" FontSize="13" Foreground="#FFC857" Margin="24,4,0,4" IsVisible="False"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Tab" FontSize="14" Foreground="#7C5CFC" FontWeight="SemiBold" Margin="0,4,24,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="HelpSearch" FontSize="14" Foreground="#E2E0F0" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" x:Name="HelpGamepadSearch" Text="X" FontSize="13" Foreground="#FFC857" Margin="24,4,0,4" IsVisible="False"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding [BigPicture_HelpKeyExit], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="14" Foreground="#7C5CFC" FontWeight="SemiBold" Margin="0,4,24,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="HelpExit" FontSize="14" Foreground="#E2E0F0" Margin="0,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="2" x:Name="HelpGamepadExit" Text="{Binding [BigPicture_HelpPadExit], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" Foreground="#FFC857" Margin="24,4,0,4" IsVisible="False"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding [BigPicture_HelpKeyHomeEnd], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="14" Foreground="#7C5CFC" FontWeight="SemiBold" Margin="0,4,24,4"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="HelpHomeEnd" FontSize="14" Foreground="#E2E0F0" Margin="0,4"/>
                            <TextBlock Grid.Row="6" Grid.Column="2" x:Name="HelpGamepadHomeEnd" Text="{Binding [BigPicture_HelpPadHomeEnd], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" Foreground="#FFC857" Margin="24,4,0,4" IsVisible="False"/>
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding [BigPicture_HelpKeyPageNav], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="14" Foreground="#7C5CFC" FontWeight="SemiBold" Margin="0,4,24,4"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="HelpPage" FontSize="14" Foreground="#E2E0F0" Margin="0,4"/>
                            <TextBlock Grid.Row="7" Grid.Column="2" x:Name="HelpGamepadPage" Text="{Binding [BigPicture_HelpPadPage], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" Foreground="#FFC857" Margin="24,4,0,4" IsVisible="False"/>
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="+ / −" FontSize="14" Foreground="#7C5CFC" FontWeight="SemiBold" Margin="0,4,24,4"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" x:Name="HelpZoom" FontSize="14" Foreground="#E2E0F0" Margin="0,4"/>
                            <TextBlock Grid.Row="8" Grid.Column="2" x:Name="HelpGamepadZoom" Text="{Binding [BigPicture_HelpPadZoom], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" Foreground="#FFC857" Margin="24,4,0,4" IsVisible="False"/>
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="H / ?" FontSize="14" Foreground="#7C5CFC" FontWeight="SemiBold" Margin="0,4,24,4"/>
                            <TextBlock Grid.Row="9" Grid.Column="1" x:Name="HelpToggle" FontSize="14" Foreground="#E2E0F0" Margin="0,4"/>
                            <TextBlock Grid.Row="9" Grid.Column="2" x:Name="HelpGamepadToggle" Text="{Binding [BigPicture_HelpPadHelp], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" Foreground="#FFC857" Margin="24,4,0,4" IsVisible="False"/>
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="I" FontSize="14" Foreground="#7C5CFC" FontWeight="SemiBold" Margin="0,4,24,4"/>
                            <TextBlock Grid.Row="10" Grid.Column="1" x:Name="HelpRomInfo" FontSize="14" Foreground="#E2E0F0" Margin="0,4"/>
                            <TextBlock Grid.Row="10" Grid.Column="2" x:Name="HelpGamepadRomInfo" Text="B" FontSize="13" Foreground="#FFC857" Margin="24,4,0,4" IsVisible="False"/>
                            <TextBlock Grid.Row="11" Grid.Column="0" Text="R" FontSize="14" Foreground="#7C5CFC" FontWeight="SemiBold" Margin="0,4,24,4"/>
                            <TextBlock Grid.Row="11" Grid.Column="1" x:Name="HelpRandom" FontSize="14" Foreground="#E2E0F0" Margin="0,4"/>
                            <TextBlock Grid.Row="11" Grid.Column="2" x:Name="HelpGamepadRandom" Text="{Binding [BigPicture_HelpPadRandom], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" Foreground="#FFC857" Margin="24,4,0,4" IsVisible="False"/>
                            <TextBlock Grid.Row="12" Grid.Column="0" Text="A – Z" FontSize="14" Foreground="#7C5CFC" FontWeight="SemiBold" Margin="0,4,24,4"/>
                            <TextBlock Grid.Row="12" Grid.Column="1" x:Name="HelpLetterJump" FontSize="14" Foreground="#E2E0F0" Margin="0,4"/>
                            <TextBlock Grid.Row="13" Grid.Column="0" Text="P" FontSize="14" Foreground="#7C5CFC" FontWeight="SemiBold" Margin="0,4,24,4"/>
                            <TextBlock Grid.Row="13" Grid.Column="1" x:Name="HelpRecentlyPlayed" FontSize="14" Foreground="#E2E0F0" Margin="0,4"/>
                            <TextBlock Grid.Row="13" Grid.Column="2" x:Name="HelpGamepadRecentlyPlayed" Text="{Binding [BigPicture_HelpPadRecentlyPlayed], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" Foreground="#FFC857" Margin="24,4,0,4" IsVisible="False"/>
                            <TextBlock Grid.Row="14" Grid.Column="0" Text="C" FontSize="14" Foreground="#7C5CFC" FontWeight="SemiBold" Margin="0,4,24,4"/>
                            <TextBlock Grid.Row="14" Grid.Column="1" x:Name="HelpStats" FontSize="14" Foreground="#E2E0F0" Margin="0,4"/>
                            <TextBlock Grid.Row="14" Grid.Column="2" x:Name="HelpGamepadStats" Text="{Binding [BigPicture_HelpPadStats], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" Foreground="#FFC857" Margin="24,4,0,4" IsVisible="False"/>
                            <TextBlock Grid.Row="15" Grid.Column="0" Text="[ / ]" FontSize="14" Foreground="#7C5CFC" FontWeight="SemiBold" Margin="0,4,24,4"/>
                            <TextBlock Grid.Row="15" Grid.Column="1" x:Name="HelpSystemCycle" FontSize="14" Foreground="#E2E0F0" Margin="0,4"/>
                            <TextBlock Grid.Row="15" Grid.Column="2" x:Name="HelpGamepadSystemCycle" Text="{Binding [BigPicture_HelpPadSystemCycle], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" Foreground="#FFC857" Margin="24,4,0,4" IsVisible="False"/>
                            <TextBlock Grid.Row="16" Grid.Column="0" Text="G" FontSize="14" Foreground="#7C5CFC" FontWeight="SemiBold" Margin="0,4,24,4"/>
                            <TextBlock Grid.Row="16" Grid.Column="1" x:Name="HelpGallery" FontSize="14" Foreground="#E2E0F0" Margin="0,4"/>
                            <TextBlock Grid.Row="16" Grid.Column="2" x:Name="HelpGamepadGallery" Text="{Binding [BigPicture_HelpPadGallery], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" Foreground="#FFC857" Margin="24,4,0,4" IsVisible="False"/>
                            <TextBlock Grid.Row="17" Grid.Column="0" Text="V" FontSize="14" Foreground="#7C5CFC" FontWeight="SemiBold" Margin="0,4,24,4"/>
                            <TextBlock Grid.Row="17" Grid.Column="1" x:Name="HelpArtworkViewer" FontSize="14" Foreground="#E2E0F0" Margin="0,4"/>
                            <TextBlock Grid.Row="17" Grid.Column="2" x:Name="HelpGamepadArtworkViewer" Text="{Binding [BigPicture_HelpPadArtworkViewer], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" Foreground="#FFC857" Margin="24,4,0,4" IsVisible="False"/>
                            <TextBlock Grid.Row="18" Grid.Column="0" Text="1 – 5" FontSize="14" Foreground="#7C5CFC" FontWeight="SemiBold" Margin="0,4,24,4"/>
                            <TextBlock Grid.Row="18" Grid.Column="1" x:Name="HelpRating" FontSize="14" Foreground="#E2E0F0" Margin="0,4"/>
                            <TextBlock Grid.Row="18" Grid.Column="2" x:Name="HelpGamepadRating" Text="{Binding [BigPicture_HelpPadRating], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" Foreground="#FFC857" Margin="24,4,0,4" IsVisible="False"/>
                            <TextBlock Grid.Row="19" Grid.Column="0" Text="⏱" FontSize="14" Foreground="#7C5CFC" FontWeight="SemiBold" Margin="0,4,24,4"/>
                            <TextBlock Grid.Row="19" Grid.Column="1" x:Name="HelpPlayTime" FontSize="14" Foreground="#E2E0F0" Margin="0,4"/>
                            <Border Grid.Row="20" Grid.ColumnSpan="3" Background="#2A2A40" Height="1" Margin="0,8"/>
                            <TextBlock Grid.Row="21" Grid.ColumnSpan="3" x:Name="HelpScreensaver"
                                       FontSize="13" Foreground="#5A5A7A" HorizontalAlignment="Center" Margin="0,4"/>
                            <TextBlock Grid.Row="22" Grid.ColumnSpan="3" x:Name="HelpDismiss"
                                       FontSize="13" Foreground="#5A5A7A" HorizontalAlignment="Center" Margin="0,4"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ═══ ROM Info Overlay ═══ -->
            <Border x:Name="RomInfoOverlay"
                    Background="#EE0D0D14" IsVisible="False"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Padding="0" ZIndex="11">
                <Border Background="#1A1A2E" CornerRadius="16" Padding="44,36"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="700" BorderBrush="#2A2A40" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock x:Name="RomInfoOverlayTitle" FontSize="22" FontWeight="Bold"
                                   Foreground="#E2E0F0" HorizontalAlignment="Center"/>
                        <Border Background="#2A2A40" Height="1" Margin="0,0,0,4"/>
                        <ScrollViewer MaxHeight="480" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16">
                                <StackPanel x:Name="RomInfoDetailsSection" Spacing="4"/>
                                <StackPanel x:Name="RomInfoChecksumsSection" Spacing="4"/>
                                <StackPanel x:Name="RomInfoGoodToolsSection" Spacing="4"/>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Background="#2A2A40" Height="1" Margin="0,4,0,0"/>
                        <TextBlock x:Name="RomInfoDismiss" FontSize="13" Foreground="#5A5A7A"
                                   HorizontalAlignment="Center" Margin="0,4"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ═══ Stats Overlay ═══ -->
            <Border x:Name="StatsOverlay"
                    Background="#EE0D0D14" IsVisible="False"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Padding="0" ZIndex="12">
                <Border Background="#1A1A2E" CornerRadius="16" Padding="44,36"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MinWidth="500" MaxWidth="780" BorderBrush="#2A2A40" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock x:Name="StatsOverlayTitle" FontSize="22" FontWeight="Bold"
                                   Foreground="#E2E0F0" HorizontalAlignment="Center"/>
                        <Border Background="#2A2A40" Height="1" Margin="0,0,0,4"/>
                        <ScrollViewer MaxHeight="480" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="StatsContent" Spacing="4"/>
                        </ScrollViewer>
                        <Border Background="#2A2A40" Height="1" Margin="0,4,0,0"/>
                        <TextBlock x:Name="StatsDismiss" FontSize="13" Foreground="#5A5A7A"
                                   HorizontalAlignment="Center" Margin="0,4"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ═══ Artwork Viewer Overlay ═══ -->
            <Border x:Name="ArtworkViewerOverlay"
                    Background="#F00D0D14" IsVisible="False"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Padding="0" ZIndex="13">
                <Grid>
                    <Image x:Name="ArtworkViewerImage" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="48"/>
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <TextBlock x:Name="ArtworkViewerTitle" FontSize="20" FontWeight="Bold"
                                   Foreground="#E2E0F0" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock x:Name="ArtworkViewerLabel" FontSize="14"
                                   Foreground="#7C5CFC" HorizontalAlignment="Center"
                                   TextAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Margin="0,0,0,32" Spacing="4">
                        <TextBlock x:Name="ArtworkViewerCounter" FontSize="14"
                                   Foreground="#9A9ABE" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock x:Name="ArtworkViewerDismiss" FontSize="13"
                                   Foreground="#5A5A7A" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Letter Jump Indicator ═══ -->
            <Border x:Name="LetterJumpOverlay"
                    Background="#DD1A1A2E" IsVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="20" Padding="36,24" ZIndex="15"
                    IsHitTestVisible="False">
                <TextBlock x:Name="LetterJumpText" FontSize="72" FontWeight="Bold"
                           Foreground="#7C5CFC" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- ═══ System Cycle Indicator ═══ -->
            <Border x:Name="SystemCycleOverlay"
                    Background="#DD1A1A2E" IsVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="20" Padding="36,24" ZIndex="15"
                    IsHitTestVisible="False">
                <TextBlock x:Name="SystemCycleText" FontSize="36" FontWeight="Bold"
                           Foreground="#7C5CFC" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- ═══ Screensaver / Attract Mode ═══ -->
            <Border x:Name="ScreensaverOverlay"
                    Background="#0D0D14" IsVisible="False"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    ZIndex="30">
                <Grid>
                    <Image x:Name="ScreensaverImage" Stretch="Uniform"
                           MaxWidth="800" MaxHeight="600"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Margin="0,0,0,48" Spacing="8">
                        <TextBlock x:Name="ScreensaverTitle" FontSize="28" FontWeight="Bold"
                                   Foreground="#E2E0F0" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock x:Name="ScreensaverSystem" FontSize="16"
                                   Foreground="#7C5CFC" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock x:Name="ScreensaverDismiss" FontSize="13"
                                   Foreground="#5A5A7A" HorizontalAlignment="Center"
                                   Margin="0,12,0,0" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
