<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RetroMultiTools.Localization"
             x:Class="RetroMultiTools.Views.RetroArch.RetroArchConfiguratorView">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16">
        <TextBlock Text="{Binding [RAConfig_Title], Source={x:Static loc:LocalizationManager.Instance}}"
                   FontSize="18" FontWeight="Bold" Foreground="#CDD6F4"/>
        <TextBlock Text="{Binding [RAConfig_Description], Source={x:Static loc:LocalizationManager.Instance}}"
                   Foreground="#A6ADC8" TextWrapping="Wrap"/>

        <!-- CFG File Selection -->
        <Border Background="#181825" CornerRadius="6" Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding [RAConfig_ConfigFile], Source={x:Static loc:LocalizationManager.Instance}}"
                           FontWeight="SemiBold" Foreground="#CDD6F4"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="CfgFilePathTextBox" Width="400" IsReadOnly="True"
                             Watermark="{Binding [RAConfig_CfgPlaceholder], Source={x:Static loc:LocalizationManager.Instance}}" Padding="8,6"/>
                    <Button x:Name="BrowseCfgButton" Content="{Binding [Common_Browse], Source={x:Static loc:LocalizationManager.Instance}}"
                            Click="BrowseCfgButton_Click" Padding="12,6"/>
                    <Button x:Name="AutoDetectCfgButton" Content="{Binding [Settings_AutoDetect], Source={x:Static loc:LocalizationManager.Instance}}"
                            Click="AutoDetectCfgButton_Click" Padding="12,6"/>
                </StackPanel>
                <TextBlock x:Name="CfgStatusText" Foreground="#A6ADC8" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Search/Filter -->
        <Border x:Name="SearchBorder" Background="#181825" CornerRadius="6" Padding="12" IsVisible="False">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding [RAConfig_SearchSettings], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                <TextBox x:Name="SearchTextBox" Watermark="{Binding [RAConfig_SearchPlaceholder], Source={x:Static loc:LocalizationManager.Instance}}" Padding="8,6"/>
                <TextBlock x:Name="SearchResultsText" Foreground="#A6ADC8" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- Tab Control for Configuration Categories -->
        <TabControl x:Name="ConfigTabs" IsVisible="False">

            <!-- PATHS TAB -->
            <TabItem Header="{Binding [RAConfig_TabPaths], Source={x:Static loc:LocalizationManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <Border x:Name="Section_CorePaths" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_CorePaths], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="libretro_directory" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_libretro_directory" Grid.Row="0" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="libretro_info_path" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_libretro_info_path" Grid.Row="1" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="system_directory" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_system_directory" Grid.Row="2" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="content_database_path" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_content_database_path" Grid.Row="3" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="cheat_database_path" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_cheat_database_path" Grid.Row="4" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="cursor_directory" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_cursor_directory" Grid.Row="5" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="assets_directory" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_assets_directory" Grid.Row="6" Grid.Column="1" Padding="6,4" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Section_ContentPaths" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_ContentPaths], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="savefile_directory" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_savefile_directory" Grid.Row="0" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="savestate_directory" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_savestate_directory" Grid.Row="1" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="screenshot_directory" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_screenshot_directory" Grid.Row="2" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="cache_directory" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_cache_directory" Grid.Row="3" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="playlist_directory" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_playlist_directory" Grid.Row="4" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="core_assets_directory" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_core_assets_directory" Grid.Row="5" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="thumbnails_directory" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_thumbnails_directory" Grid.Row="6" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="dynamic_wallpapers_directory" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_dynamic_wallpapers_directory" Grid.Row="7" Grid.Column="1" Padding="6,4" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Section_FilterPaths" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_FilterPaths], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="video_shader_dir" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_video_shader_dir" Grid.Row="0" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="video_filter_dir" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_video_filter_dir" Grid.Row="1" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="audio_filter_dir" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_audio_filter_dir" Grid.Row="2" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="input_remapping_directory" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_remapping_directory" Grid.Row="3" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="joypad_autoconfig_dir" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_joypad_autoconfig_dir" Grid.Row="4" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="rgui_config_directory" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_rgui_config_directory" Grid.Row="5" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="rgui_browser_directory" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_rgui_browser_directory" Grid.Row="6" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="overlay_directory" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_overlay_directory" Grid.Row="7" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="osk_overlay_directory" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_osk_overlay_directory" Grid.Row="8" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="recording_output_directory" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_recording_output_directory" Grid.Row="9" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="recording_config_directory" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_recording_config_directory" Grid.Row="10" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="11" Grid.Column="0" Text="log_dir" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_log_dir" Grid.Row="11" Grid.Column="1" Padding="6,4" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- VIDEO TAB -->
            <TabItem Header="{Binding [RAConfig_TabVideo], Source={x:Static loc:LocalizationManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <Border x:Name="Section_VideoDriver" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_VideoDriver], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="video_driver" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <ComboBox x:Name="Cfg_video_driver" Grid.Row="0" Grid.Column="1" MinWidth="200" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="video_context_driver" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_video_context_driver" Grid.Row="1" Grid.Column="1" Padding="6,4" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Section_VideoDisplay" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_VideoDisplay], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="video_fullscreen" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_video_fullscreen" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="video_windowed_fullscreen" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_video_windowed_fullscreen" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="video_monitor_index" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_video_monitor_index" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="16" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="video_fullscreen_x" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_video_fullscreen_x" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="7680" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="video_fullscreen_y" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_video_fullscreen_y" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="4320" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="video_window_opacity" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_video_window_opacity" Grid.Row="5" Grid.Column="1" Minimum="1" Maximum="100" Value="100" FontSize="12"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="video_window_show_decorations" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_video_window_show_decorations" Grid.Row="6" Grid.Column="1"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="video_rotation" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <ComboBox x:Name="Cfg_video_rotation" Grid.Row="7" Grid.Column="1" MinWidth="200" FontSize="12"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="video_allow_rotate" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_video_allow_rotate" Grid.Row="8" Grid.Column="1"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="video_window_x" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_video_window_x" Grid.Row="9" Grid.Column="1" Minimum="0" Maximum="7680" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="video_window_y" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_video_window_y" Grid.Row="10" Grid.Column="1" Minimum="0" Maximum="4320" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="11" Grid.Column="0" Text="video_window_auto_width_max" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_video_window_auto_width_max" Grid.Row="11" Grid.Column="1" Minimum="0" Maximum="7680" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="12" Grid.Column="0" Text="video_window_auto_height_max" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_video_window_auto_height_max" Grid.Row="12" Grid.Column="1" Minimum="0" Maximum="4320" Value="0" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Section_VideoSync" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_VideoSync], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="video_vsync" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_video_vsync" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="video_adaptive_vsync" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_video_adaptive_vsync" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="video_swap_interval" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_video_swap_interval" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="4" Value="1" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="video_max_swapchain_images" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_video_max_swapchain_images" Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="4" Value="3" FontSize="12"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="video_hard_sync" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_video_hard_sync" Grid.Row="4" Grid.Column="1"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="video_hard_sync_frames" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_video_hard_sync_frames" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="3" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="video_frame_delay" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_video_frame_delay" Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="20" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="video_frame_delay_auto" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_video_frame_delay_auto" Grid.Row="7" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Section_VideoScaling" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_VideoScaling], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="video_scale" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_video_scale" Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="10" Value="3" Increment="0.5" FormatString="F1" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="video_force_aspect" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_video_force_aspect" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="video_aspect_ratio_auto" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_video_aspect_ratio_auto" Grid.Row="2" Grid.Column="1"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="video_aspect_ratio" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_video_aspect_ratio" Grid.Row="3" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="video_smooth" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_video_smooth" Grid.Row="4" Grid.Column="1"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="video_crop_overscan" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_video_crop_overscan" Grid.Row="5" Grid.Column="1"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="video_threaded" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_video_threaded" Grid.Row="6" Grid.Column="1"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="video_black_frame_insertion" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_video_black_frame_insertion" Grid.Row="7" Grid.Column="1" Minimum="0" Maximum="5" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="video_shader_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_video_shader_enable" Grid.Row="8" Grid.Column="1"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="video_ctx_scaling" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_video_ctx_scaling" Grid.Row="9" Grid.Column="1"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="video_shared_context" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_video_shared_context" Grid.Row="10" Grid.Column="1"/>
                                <TextBlock Grid.Row="11" Grid.Column="0" Text="video_force_srgb_disable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_video_force_srgb_disable" Grid.Row="11" Grid.Column="1"/>
                                <TextBlock Grid.Row="12" Grid.Column="0" Text="video_notch_write_over_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_video_notch_write_over_enable" Grid.Row="12" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Section_VideoOSD" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_VideoOSD], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="video_font_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_video_font_enable" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="video_font_path" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_video_font_path" Grid.Row="1" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="video_font_size" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_video_font_size" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="128" Value="32" Increment="0.5" FormatString="F1" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="video_msg_color" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_video_msg_color" Grid.Row="3" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="video_gpu_screenshot" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_video_gpu_screenshot" Grid.Row="4" Grid.Column="1"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="crt_switch_resolution" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <ComboBox x:Name="Cfg_crt_switch_resolution" Grid.Row="5" Grid.Column="1" MinWidth="200" FontSize="12"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="video_msg_pos_x" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_video_msg_pos_x" Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="1" Value="0.05" Increment="0.01" FormatString="F2" FontSize="12"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="video_msg_pos_y" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_video_msg_pos_y" Grid.Row="7" Grid.Column="1" Minimum="0" Maximum="1" Value="0.05" Increment="0.01" FormatString="F2" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Section_VideoAdvanced" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_VideoAdvanced], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="video_shader" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_video_shader" Grid.Row="0" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="video_filter" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_video_filter" Grid.Row="1" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="video_record_threads" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_video_record_threads" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="16" Value="2" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="crt_switch_resolution_super" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_crt_switch_resolution_super" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="7680" Value="2560" FontSize="12"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="crt_switch_resolution_use_custom_refresh_rate" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_crt_switch_resolution_use_custom_refresh_rate" Grid.Row="4" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- AUDIO TAB -->
            <TabItem Header="{Binding [RAConfig_TabAudio], Source={x:Static loc:LocalizationManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <Border x:Name="Section_AudioDriver" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_AudioDriver], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="audio_driver" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <ComboBox x:Name="Cfg_audio_driver" Grid.Row="0" Grid.Column="1" MinWidth="200" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="audio_resampler" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <ComboBox x:Name="Cfg_audio_resampler" Grid.Row="1" Grid.Column="1" MinWidth="200" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="audio_device" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_audio_device" Grid.Row="2" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="audio_output_rate" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <ComboBox x:Name="Cfg_audio_output_rate" Grid.Row="3" Grid.Column="1" MinWidth="200" FontSize="12"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="audio_dsp_plugin" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_audio_dsp_plugin" Grid.Row="4" Grid.Column="1" Padding="6,4" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Section_AudioSync" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_AudioSync], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="audio_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_audio_enable" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="audio_sync" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_audio_sync" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="audio_rate_control" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_audio_rate_control" Grid.Row="2" Grid.Column="1"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="audio_volume" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Slider x:Name="Cfg_audio_volume" Minimum="-80" Maximum="12" Value="0" Width="250" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                                    <TextBlock x:Name="Cfg_audio_volume_label" Text="0.0 dB" Foreground="#CDD6F4" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="audio_mixer_volume" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Slider x:Name="Cfg_audio_mixer_volume" Minimum="-80" Maximum="12" Value="0" Width="250" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                                    <TextBlock x:Name="Cfg_audio_mixer_volume_label" Text="0.0 dB" Foreground="#CDD6F4" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="audio_mute_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_audio_mute_enable" Grid.Row="5" Grid.Column="1"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="audio_mixer_mute_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_audio_mixer_mute_enable" Grid.Row="6" Grid.Column="1"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="audio_fastforward_mute" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_audio_fastforward_mute" Grid.Row="7" Grid.Column="1"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="audio_latency" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_audio_latency" Grid.Row="8" Grid.Column="1" Minimum="0" Maximum="512" Value="64" FontSize="12"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="audio_wasapi_exclusive_mode" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_audio_wasapi_exclusive_mode" Grid.Row="9" Grid.Column="1"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="audio_wasapi_float_format" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_audio_wasapi_float_format" Grid.Row="10" Grid.Column="1"/>
                                <TextBlock Grid.Row="11" Grid.Column="0" Text="audio_rate_control_delta" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_audio_rate_control_delta" Grid.Row="11" Grid.Column="1" Minimum="0" Maximum="1" Value="0.005" Increment="0.001" FormatString="F3" FontSize="12"/>
                                <TextBlock Grid.Row="12" Grid.Column="0" Text="audio_max_timing_skew" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_audio_max_timing_skew" Grid.Row="12" Grid.Column="1" Minimum="0" Maximum="1" Value="0.05" Increment="0.01" FormatString="F2" FontSize="12"/>
                                <TextBlock Grid.Row="13" Grid.Column="0" Text="audio_wasapi_sh_buffer_length" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_audio_wasapi_sh_buffer_length" Grid.Row="13" Grid.Column="1" Minimum="0" Maximum="4096" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="14" Grid.Column="0" Text="audio_fastforward_speedup" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_audio_fastforward_speedup" Grid.Row="14" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- INPUT TAB -->
            <TabItem Header="{Binding [RAConfig_TabInput], Source={x:Static loc:LocalizationManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <Border x:Name="Section_InputGeneral" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_InputGeneral], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="input_driver" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <ComboBox x:Name="Cfg_input_driver" Grid.Row="0" Grid.Column="1" MinWidth="200" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="input_joypad_driver" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <ComboBox x:Name="Cfg_input_joypad_driver" Grid.Row="1" Grid.Column="1" MinWidth="200" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="input_max_users" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_max_users" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="16" Value="5" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="input_autodetect_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_input_autodetect_enable" Grid.Row="3" Grid.Column="1"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="input_remap_binds_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_input_remap_binds_enable" Grid.Row="4" Grid.Column="1"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="input_auto_mouse_grab" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_input_auto_mouse_grab" Grid.Row="5" Grid.Column="1"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="input_rumble_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_input_rumble_enable" Grid.Row="6" Grid.Column="1"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="input_sensors_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_input_sensors_enable" Grid.Row="7" Grid.Column="1"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="input_turbo_period" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_turbo_period" Grid.Row="8" Grid.Column="1" Minimum="1" Maximum="60" Value="6" FontSize="12"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="input_turbo_duty_cycle" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_turbo_duty_cycle" Grid.Row="9" Grid.Column="1" Minimum="1" Maximum="60" Value="3" FontSize="12"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="input_descriptor_label_show" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_input_descriptor_label_show" Grid.Row="10" Grid.Column="1"/>
                                <TextBlock Grid.Row="11" Grid.Column="0" Text="input_descriptor_hide_unbound" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_input_descriptor_hide_unbound" Grid.Row="11" Grid.Column="1"/>
                                <TextBlock Grid.Row="12" Grid.Column="0" Text="input_axis_threshold" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_axis_threshold" Grid.Row="12" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5" Increment="0.05" FormatString="F2" FontSize="12"/>
                                <TextBlock Grid.Row="13" Grid.Column="0" Text="input_bind_timeout" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_bind_timeout" Grid.Row="13" Grid.Column="1" Minimum="1" Maximum="30" Value="5" FontSize="12"/>
                                <TextBlock Grid.Row="14" Grid.Column="0" Text="input_bind_hold" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_bind_hold" Grid.Row="14" Grid.Column="1" Minimum="1" Maximum="10" Value="2" FontSize="12"/>
                                <TextBlock Grid.Row="15" Grid.Column="0" Text="input_turbo_mode" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_turbo_mode" Grid.Row="15" Grid.Column="1" Minimum="0" Maximum="3" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="16" Grid.Column="0" Text="input_turbo_default_button" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_turbo_default_button" Grid.Row="16" Grid.Column="1" Minimum="0" Maximum="15" Value="2" FontSize="12"/>
                                <TextBlock Grid.Row="17" Grid.Column="0" Text="input_auto_game_focus" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_auto_game_focus" Grid.Row="17" Grid.Column="1" Minimum="0" Maximum="2" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="18" Grid.Column="0" Text="input_rumble_gain" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_rumble_gain" Grid.Row="18" Grid.Column="1" Minimum="0" Maximum="100" Value="100" FontSize="12"/>
                                <TextBlock Grid.Row="19" Grid.Column="0" Text="input_menu_toggle_gamepad_combo" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_menu_toggle_gamepad_combo" Grid.Row="19" Grid.Column="1" Minimum="0" Maximum="15" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="20" Grid.Column="0" Text="input_quit_gamepad_combo" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_quit_gamepad_combo" Grid.Row="20" Grid.Column="1" Minimum="0" Maximum="15" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="21" Grid.Column="0" Text="input_poll_type_behavior" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_poll_type_behavior" Grid.Row="21" Grid.Column="1" Minimum="0" Maximum="3" Value="2" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Section_InputHotkeys" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_InputHotkeys], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="input_enable_hotkey" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_enable_hotkey" Grid.Row="0" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="input_exit_emulator" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_exit_emulator" Grid.Row="1" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="input_toggle_fullscreen" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_toggle_fullscreen" Grid.Row="2" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="input_save_state" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_save_state" Grid.Row="3" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="input_load_state" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_load_state" Grid.Row="4" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="input_toggle_fast_forward" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_toggle_fast_forward" Grid.Row="5" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="input_rewind" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_rewind" Grid.Row="6" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="input_pause_toggle" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_pause_toggle" Grid.Row="7" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="input_reset" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_reset" Grid.Row="8" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="input_screenshot" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_screenshot" Grid.Row="9" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="input_audio_mute" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_audio_mute" Grid.Row="10" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="11" Grid.Column="0" Text="input_menu_toggle" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_menu_toggle" Grid.Row="11" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="12" Grid.Column="0" Text="input_state_slot_increase" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_state_slot_increase" Grid.Row="12" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="13" Grid.Column="0" Text="input_state_slot_decrease" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_state_slot_decrease" Grid.Row="13" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="14" Grid.Column="0" Text="input_hold_fast_forward" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_hold_fast_forward" Grid.Row="14" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="15" Grid.Column="0" Text="input_toggle_slowmotion" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_toggle_slowmotion" Grid.Row="15" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="16" Grid.Column="0" Text="input_hold_slowmotion" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_hold_slowmotion" Grid.Row="16" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="17" Grid.Column="0" Text="input_frame_advance" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_frame_advance" Grid.Row="17" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="18" Grid.Column="0" Text="input_shader_next" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_shader_next" Grid.Row="18" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="19" Grid.Column="0" Text="input_shader_prev" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_shader_prev" Grid.Row="19" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="20" Grid.Column="0" Text="input_cheat_index_plus" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_cheat_index_plus" Grid.Row="20" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="21" Grid.Column="0" Text="input_cheat_index_minus" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_cheat_index_minus" Grid.Row="21" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="22" Grid.Column="0" Text="input_cheat_toggle" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_cheat_toggle" Grid.Row="22" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="23" Grid.Column="0" Text="input_osk_toggle" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_osk_toggle" Grid.Row="23" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="24" Grid.Column="0" Text="input_fps_toggle" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_fps_toggle" Grid.Row="24" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="25" Grid.Column="0" Text="input_netplay_game_watch" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_netplay_game_watch" Grid.Row="25" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="26" Grid.Column="0" Text="input_volume_up" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_volume_up" Grid.Row="26" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="27" Grid.Column="0" Text="input_volume_down" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_volume_down" Grid.Row="27" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="28" Grid.Column="0" Text="input_overlay_next" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_overlay_next" Grid.Row="28" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="29" Grid.Column="0" Text="input_disk_eject_toggle" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_disk_eject_toggle" Grid.Row="29" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="30" Grid.Column="0" Text="input_disk_next" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_disk_next" Grid.Row="30" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="31" Grid.Column="0" Text="input_disk_prev" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_disk_prev" Grid.Row="31" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="32" Grid.Column="0" Text="input_grab_mouse_toggle" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_grab_mouse_toggle" Grid.Row="32" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="33" Grid.Column="0" Text="input_game_focus_toggle" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_game_focus_toggle" Grid.Row="33" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="34" Grid.Column="0" Text="input_recording_toggle" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_recording_toggle" Grid.Row="34" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="35" Grid.Column="0" Text="input_streaming_toggle" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_streaming_toggle" Grid.Row="35" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="36" Grid.Column="0" Text="input_ai_service" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_ai_service" Grid.Row="36" Grid.Column="1" Padding="6,4" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- CORE / SAVING TAB -->
            <TabItem Header="{Binding [RAConfig_TabCore], Source={x:Static loc:LocalizationManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <Border x:Name="Section_CoreOptions" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_CoreOptions], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="core_updater_auto_extract" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_core_updater_auto_extract" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="core_updater_show_experimental_cores" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_core_updater_show_experimental_cores" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="libretro_log_level" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <ComboBox x:Name="Cfg_libretro_log_level" Grid.Row="2" Grid.Column="1" MinWidth="200" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="auto_remaps_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_auto_remaps_enable" Grid.Row="3" Grid.Column="1"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="auto_shaders_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_auto_shaders_enable" Grid.Row="4" Grid.Column="1"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="game_specific_options" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_game_specific_options" Grid.Row="5" Grid.Column="1"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="core_option_category_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_core_option_category_enable" Grid.Row="6" Grid.Column="1"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="core_set_supports_no_game_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_core_set_supports_no_game_enable" Grid.Row="7" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Section_SaveOptions" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_SaveOptions], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="savestate_auto_save" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_savestate_auto_save" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="savestate_auto_load" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_savestate_auto_load" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="savestate_auto_index" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_savestate_auto_index" Grid.Row="2" Grid.Column="1"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="savestate_thumbnail_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_savestate_thumbnail_enable" Grid.Row="3" Grid.Column="1"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="save_file_compression" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_save_file_compression" Grid.Row="4" Grid.Column="1"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="savestate_file_compression" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_savestate_file_compression" Grid.Row="5" Grid.Column="1"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="autosave_interval" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_autosave_interval" Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="3600" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="sort_savefiles_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_sort_savefiles_enable" Grid.Row="7" Grid.Column="1"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="sort_savestates_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_sort_savestates_enable" Grid.Row="8" Grid.Column="1"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="block_sram_overwrite" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_block_sram_overwrite" Grid.Row="9" Grid.Column="1"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="savestate_max_keep" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_savestate_max_keep" Grid.Row="10" Grid.Column="1" Minimum="0" Maximum="999" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="11" Grid.Column="0" Text="sort_savefiles_by_content_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_sort_savefiles_by_content_enable" Grid.Row="11" Grid.Column="1"/>
                                <TextBlock Grid.Row="12" Grid.Column="0" Text="sort_savestates_by_content_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_sort_savestates_by_content_enable" Grid.Row="12" Grid.Column="1"/>
                                <TextBlock Grid.Row="13" Grid.Column="0" Text="content_runtime_log" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_content_runtime_log" Grid.Row="13" Grid.Column="1"/>
                                <TextBlock Grid.Row="14" Grid.Column="0" Text="content_runtime_log_aggregate" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_content_runtime_log_aggregate" Grid.Row="14" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- MENU / UI TAB -->
            <TabItem Header="{Binding [RAConfig_TabMenu], Source={x:Static loc:LocalizationManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <Border x:Name="Section_MenuGeneral" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_MenuGeneral], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="menu_driver" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <ComboBox x:Name="Cfg_menu_driver" Grid.Row="0" Grid.Column="1" MinWidth="200" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="menu_linear_filter" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_linear_filter" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="menu_pause_libretro" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_pause_libretro" Grid.Row="2" Grid.Column="1"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="menu_mouse_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_mouse_enable" Grid.Row="3" Grid.Column="1"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="menu_show_sublabels" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_show_sublabels" Grid.Row="4" Grid.Column="1"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="menu_timedate_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_timedate_enable" Grid.Row="5" Grid.Column="1"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="menu_battery_level_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_battery_level_enable" Grid.Row="6" Grid.Column="1"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="menu_core_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_core_enable" Grid.Row="7" Grid.Column="1"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="menu_dynamic_wallpaper_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_dynamic_wallpaper_enable" Grid.Row="8" Grid.Column="1"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="menu_show_quit_retroarch" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_show_quit_retroarch" Grid.Row="9" Grid.Column="1"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="menu_pointer_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_pointer_enable" Grid.Row="10" Grid.Column="1"/>
                                <TextBlock Grid.Row="11" Grid.Column="0" Text="menu_swap_ok_cancel_buttons" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_swap_ok_cancel_buttons" Grid.Row="11" Grid.Column="1"/>
                                <TextBlock Grid.Row="12" Grid.Column="0" Text="menu_show_online_updater" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_show_online_updater" Grid.Row="12" Grid.Column="1"/>
                                <TextBlock Grid.Row="13" Grid.Column="0" Text="menu_show_core_updater" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_show_core_updater" Grid.Row="13" Grid.Column="1"/>
                                <TextBlock Grid.Row="14" Grid.Column="0" Text="menu_show_load_core" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_show_load_core" Grid.Row="14" Grid.Column="1"/>
                                <TextBlock Grid.Row="15" Grid.Column="0" Text="menu_show_load_content" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_show_load_content" Grid.Row="15" Grid.Column="1"/>
                                <TextBlock Grid.Row="16" Grid.Column="0" Text="menu_show_information" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_show_information" Grid.Row="16" Grid.Column="1"/>
                                <TextBlock Grid.Row="17" Grid.Column="0" Text="menu_show_configurations" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_show_configurations" Grid.Row="17" Grid.Column="1"/>
                                <TextBlock Grid.Row="18" Grid.Column="0" Text="menu_show_help" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_show_help" Grid.Row="18" Grid.Column="1"/>
                                <TextBlock Grid.Row="19" Grid.Column="0" Text="menu_show_restart_retroarch" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_show_restart_retroarch" Grid.Row="19" Grid.Column="1"/>
                                <TextBlock Grid.Row="20" Grid.Column="0" Text="menu_show_reboot" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_show_reboot" Grid.Row="20" Grid.Column="1"/>
                                <TextBlock Grid.Row="21" Grid.Column="0" Text="menu_show_shutdown" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_show_shutdown" Grid.Row="21" Grid.Column="1"/>
                                <TextBlock Grid.Row="22" Grid.Column="0" Text="menu_horizontal_animation" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_horizontal_animation" Grid.Row="22" Grid.Column="1"/>
                                <TextBlock Grid.Row="23" Grid.Column="0" Text="menu_savestate_resume" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_savestate_resume" Grid.Row="23" Grid.Column="1"/>
                                <TextBlock Grid.Row="24" Grid.Column="0" Text="menu_insert_disk_resume" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_insert_disk_resume" Grid.Row="24" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Section_MenuTheme" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_MenuTheme], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ozone_menu_color_theme" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_ozone_menu_color_theme" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="10" Value="1" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="materialui_menu_color_theme" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_materialui_menu_color_theme" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="20" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="xmb_alpha_factor" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_xmb_alpha_factor" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="75" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="menu_screensaver_timeout" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_menu_screensaver_timeout" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="3600" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="xmb_dark_mode" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_xmb_dark_mode" Grid.Row="4" Grid.Column="1"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="menu_timedate_style" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_menu_timedate_style" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="11" Value="5" FontSize="12"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="menu_ticker_type" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_menu_ticker_type" Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="2" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="menu_ticker_speed" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_menu_ticker_speed" Grid.Row="7" Grid.Column="1" Minimum="0.1" Maximum="10" Value="2" Increment="0.1" FormatString="F1" FontSize="12"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="menu_xmb_animation_horizontal_highlight" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_menu_xmb_animation_horizontal_highlight" Grid.Row="8" Grid.Column="1" Minimum="0" Maximum="2" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="menu_xmb_animation_move_up_down" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_menu_xmb_animation_move_up_down" Grid.Row="9" Grid.Column="1" Minimum="0" Maximum="1" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="menu_xmb_animation_opening_main_menu" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_menu_xmb_animation_opening_main_menu" Grid.Row="10" Grid.Column="1" Minimum="0" Maximum="3" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="11" Grid.Column="0" Text="menu_remember_selection" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_menu_remember_selection" Grid.Row="11" Grid.Column="1" Minimum="0" Maximum="2" Value="1" FontSize="12"/>
                                <TextBlock Grid.Row="12" Grid.Column="0" Text="menu_quit_on_close_content" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_menu_quit_on_close_content" Grid.Row="12" Grid.Column="1" Minimum="0" Maximum="2" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="13" Grid.Column="0" Text="menu_screensaver_animation" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_menu_screensaver_animation" Grid.Row="13" Grid.Column="1" Minimum="0" Maximum="5" Value="1" FontSize="12"/>
                                <TextBlock Grid.Row="14" Grid.Column="0" Text="menu_screensaver_animation_speed" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_menu_screensaver_animation_speed" Grid.Row="14" Grid.Column="1" Minimum="0.1" Maximum="10" Value="1" Increment="0.1" FormatString="F1" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Section_RGUITheme" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_RGUITheme], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="menu_rgui_internal_upscale_level" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_menu_rgui_internal_upscale_level" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="4" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="menu_rgui_full_width_layout" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_rgui_full_width_layout" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="menu_rgui_color_theme" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_menu_rgui_color_theme" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="30" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="menu_rgui_shadows" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_rgui_shadows" Grid.Row="3" Grid.Column="1"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="menu_rgui_particle_effect" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_menu_rgui_particle_effect" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="6" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="menu_rgui_thumbnail_downscaler" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_menu_rgui_thumbnail_downscaler" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="3" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="menu_rgui_inline_thumbnails" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_rgui_inline_thumbnails" Grid.Row="6" Grid.Column="1"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="menu_rgui_swap_thumbnails" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_rgui_swap_thumbnails" Grid.Row="7" Grid.Column="1"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="menu_rgui_extended_ascii" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_rgui_extended_ascii" Grid.Row="8" Grid.Column="1"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="menu_rgui_background_filler_thickness_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_rgui_background_filler_thickness_enable" Grid.Row="9" Grid.Column="1"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="menu_rgui_border_filler_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_rgui_border_filler_enable" Grid.Row="10" Grid.Column="1"/>
                                <TextBlock Grid.Row="11" Grid.Column="0" Text="menu_rgui_border_filler_thickness_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_rgui_border_filler_thickness_enable" Grid.Row="11" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- NETWORK / NETPLAY TAB -->
            <TabItem Header="{Binding [RAConfig_TabNetwork], Source={x:Static loc:LocalizationManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <Border x:Name="Section_NetworkGeneral" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_NetworkGeneral], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="network_cmd_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_network_cmd_enable" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="network_cmd_port" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_network_cmd_port" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="65535" Value="55355" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="network_remote_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_network_remote_enable" Grid.Row="2" Grid.Column="1"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="stdin_cmd_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_stdin_cmd_enable" Grid.Row="3" Grid.Column="1"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="updater_buildbot_cores_url" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_updater_buildbot_cores_url" Grid.Row="4" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="updater_buildbot_assets_url" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_updater_buildbot_assets_url" Grid.Row="5" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="network_remote_base_port" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_network_remote_base_port" Grid.Row="6" Grid.Column="1" Minimum="1" Maximum="65535" Value="55400" FontSize="12"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="network_on_demand_thumbnails" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_network_on_demand_thumbnails" Grid.Row="7" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Section_Netplay" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_Netplay], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="netplay" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_netplay" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="netplay_ip_address" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_netplay_ip_address" Grid.Row="1" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="netplay_ip_port" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_netplay_ip_port" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="65535" Value="55435" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="netplay_delay_frames" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_netplay_delay_frames" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="60" Value="16" FontSize="12"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="netplay_use_mitm_server" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_netplay_use_mitm_server" Grid.Row="4" Grid.Column="1"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="netplay_nat_traversal" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_netplay_nat_traversal" Grid.Row="5" Grid.Column="1"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="netplay_stateless_mode" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_netplay_stateless_mode" Grid.Row="6" Grid.Column="1"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="netplay_start_as_spectator" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_netplay_start_as_spectator" Grid.Row="7" Grid.Column="1"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="netplay_check_frames" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_netplay_check_frames" Grid.Row="8" Grid.Column="1" Minimum="0" Maximum="9999" Value="600" FontSize="12"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="netplay_mitm_server" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_netplay_mitm_server" Grid.Row="9" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="netplay_password" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_netplay_password" Grid.Row="10" Grid.Column="1" Padding="6,4" FontSize="12" PasswordChar="●"/>
                                <TextBlock Grid.Row="11" Grid.Column="0" Text="netplay_spectate_password" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_netplay_spectate_password" Grid.Row="11" Grid.Column="1" Padding="6,4" FontSize="12" PasswordChar="●"/>
                                <TextBlock Grid.Row="12" Grid.Column="0" Text="netplay_allow_slaves" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_netplay_allow_slaves" Grid.Row="12" Grid.Column="1"/>
                                <TextBlock Grid.Row="13" Grid.Column="0" Text="netplay_require_slaves" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_netplay_require_slaves" Grid.Row="13" Grid.Column="1"/>
                                <TextBlock Grid.Row="14" Grid.Column="0" Text="netplay_share_digital" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_netplay_share_digital" Grid.Row="14" Grid.Column="1" Minimum="0" Maximum="3" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="15" Grid.Column="0" Text="netplay_share_analog" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_netplay_share_analog" Grid.Row="15" Grid.Column="1" Minimum="0" Maximum="3" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="16" Grid.Column="0" Text="netplay_request_device_p1" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_netplay_request_device_p1" Grid.Row="16" Grid.Column="1"/>
                                <TextBlock Grid.Row="17" Grid.Column="0" Text="netplay_request_device_p2" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_netplay_request_device_p2" Grid.Row="17" Grid.Column="1"/>
                                <TextBlock Grid.Row="18" Grid.Column="0" Text="netplay_request_device_p3" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_netplay_request_device_p3" Grid.Row="18" Grid.Column="1"/>
                                <TextBlock Grid.Row="19" Grid.Column="0" Text="netplay_request_device_p4" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_netplay_request_device_p4" Grid.Row="19" Grid.Column="1"/>
                                <TextBlock Grid.Row="20" Grid.Column="0" Text="netplay_request_device_p5" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_netplay_request_device_p5" Grid.Row="20" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- FRAME THROTTLE / REWIND TAB -->
            <TabItem Header="{Binding [RAConfig_TabFrameThrottle], Source={x:Static loc:LocalizationManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <Border x:Name="Section_FrameThrottle" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_FrameThrottle], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="fastforward_ratio" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_fastforward_ratio" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="20" Value="0" Increment="0.5" FormatString="F1" FontSize="12" Watermark="0 = Unlimited"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="slowmotion_ratio" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_slowmotion_ratio" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="10" Value="3" Increment="0.5" FormatString="F1" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="vrr_runloop_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_vrr_runloop_enable" Grid.Row="2" Grid.Column="1"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="menu_throttle_framerate" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_menu_throttle_framerate" Grid.Row="3" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Section_Rewind" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_Rewind], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="rewind_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_rewind_enable" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="rewind_buffer_size" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_rewind_buffer_size" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="1024" Value="20" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="rewind_buffer_size_step" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_rewind_buffer_size_step" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="100" Value="10" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="rewind_granularity" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_rewind_granularity" Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="60" Value="1" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ACHIEVEMENTS TAB -->
            <TabItem Header="{Binding [RAConfig_TabAchievements], Source={x:Static loc:LocalizationManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <Border x:Name="Section_AchievementOptions" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_AchievementOptions], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="cheevos_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_cheevos_enable" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="cheevos_test_unofficial" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_cheevos_test_unofficial" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="cheevos_hardcore_mode_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_cheevos_hardcore_mode_enable" Grid.Row="2" Grid.Column="1"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="cheevos_leaderboards_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_cheevos_leaderboards_enable" Grid.Row="3" Grid.Column="1"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="cheevos_richpresence_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_cheevos_richpresence_enable" Grid.Row="4" Grid.Column="1"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="cheevos_badges_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_cheevos_badges_enable" Grid.Row="5" Grid.Column="1"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="cheevos_verbose_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_cheevos_verbose_enable" Grid.Row="6" Grid.Column="1"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="cheevos_auto_screenshot" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_cheevos_auto_screenshot" Grid.Row="7" Grid.Column="1"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="cheevos_unlock_sound_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_cheevos_unlock_sound_enable" Grid.Row="8" Grid.Column="1"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="cheevos_start_active" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_cheevos_start_active" Grid.Row="9" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Section_AchievementDisplay" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_AchievementDisplay], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="cheevos_appearance_anchor" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_cheevos_appearance_anchor" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="5" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="cheevos_appearance_padding_auto" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_cheevos_appearance_padding_auto" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="cheevos_visibility_unlock" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_cheevos_visibility_unlock" Grid.Row="2" Grid.Column="1"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="cheevos_visibility_mastery" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_cheevos_visibility_mastery" Grid.Row="3" Grid.Column="1"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="cheevos_visibility_account" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_cheevos_visibility_account" Grid.Row="4" Grid.Column="1"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="cheevos_visibility_summary" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_cheevos_visibility_summary" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="2" Value="0" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- OVERLAY TAB -->
            <TabItem Header="{Binding [RAConfig_TabOverlay], Source={x:Static loc:LocalizationManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <Border x:Name="Section_OverlaySettings" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_OverlaySettings], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="input_overlay_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_input_overlay_enable" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="input_overlay" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_input_overlay" Grid.Row="1" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="input_overlay_behind_menu" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_input_overlay_behind_menu" Grid.Row="2" Grid.Column="1"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="input_overlay_hide_in_menu" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_input_overlay_hide_in_menu" Grid.Row="3" Grid.Column="1"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="input_overlay_hide_when_gamepad_connected" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_input_overlay_hide_when_gamepad_connected" Grid.Row="4" Grid.Column="1"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="input_overlay_show_inputs" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_overlay_show_inputs" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="3" Value="2" FontSize="12"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="input_overlay_show_inputs_port" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_overlay_show_inputs_port" Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="16" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="input_overlay_opacity" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_overlay_opacity" Grid.Row="7" Grid.Column="1" Minimum="0" Maximum="1" Value="0.7" Increment="0.05" FormatString="F2" FontSize="12"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="input_overlay_auto_scale" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_input_overlay_auto_scale" Grid.Row="8" Grid.Column="1"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="input_overlay_scale_landscape" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_overlay_scale_landscape" Grid.Row="9" Grid.Column="1" Minimum="0" Maximum="3" Value="1" Increment="0.05" FormatString="F2" FontSize="12"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="input_overlay_aspect_adjust_landscape" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_overlay_aspect_adjust_landscape" Grid.Row="10" Grid.Column="1" Minimum="-3" Maximum="3" Value="0" Increment="0.05" FormatString="F2" FontSize="12"/>
                                <TextBlock Grid.Row="11" Grid.Column="0" Text="input_overlay_x_separation_landscape" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_overlay_x_separation_landscape" Grid.Row="11" Grid.Column="1" Minimum="-3" Maximum="3" Value="0" Increment="0.05" FormatString="F2" FontSize="12"/>
                                <TextBlock Grid.Row="12" Grid.Column="0" Text="input_overlay_y_separation_landscape" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_overlay_y_separation_landscape" Grid.Row="12" Grid.Column="1" Minimum="-3" Maximum="3" Value="0" Increment="0.05" FormatString="F2" FontSize="12"/>
                                <TextBlock Grid.Row="13" Grid.Column="0" Text="input_overlay_x_offset_landscape" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_overlay_x_offset_landscape" Grid.Row="13" Grid.Column="1" Minimum="-3" Maximum="3" Value="0" Increment="0.05" FormatString="F2" FontSize="12"/>
                                <TextBlock Grid.Row="14" Grid.Column="0" Text="input_overlay_y_offset_landscape" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_overlay_y_offset_landscape" Grid.Row="14" Grid.Column="1" Minimum="-3" Maximum="3" Value="0" Increment="0.05" FormatString="F2" FontSize="12"/>
                                <TextBlock Grid.Row="15" Grid.Column="0" Text="input_overlay_scale_portrait" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_overlay_scale_portrait" Grid.Row="15" Grid.Column="1" Minimum="0" Maximum="3" Value="1" Increment="0.05" FormatString="F2" FontSize="12"/>
                                <TextBlock Grid.Row="16" Grid.Column="0" Text="input_overlay_aspect_adjust_portrait" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_overlay_aspect_adjust_portrait" Grid.Row="16" Grid.Column="1" Minimum="-3" Maximum="3" Value="0" Increment="0.05" FormatString="F2" FontSize="12"/>
                                <TextBlock Grid.Row="17" Grid.Column="0" Text="input_overlay_x_separation_portrait" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_overlay_x_separation_portrait" Grid.Row="17" Grid.Column="1" Minimum="-3" Maximum="3" Value="0" Increment="0.05" FormatString="F2" FontSize="12"/>
                                <TextBlock Grid.Row="18" Grid.Column="0" Text="input_overlay_y_separation_portrait" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_input_overlay_y_separation_portrait" Grid.Row="18" Grid.Column="1" Minimum="-3" Maximum="3" Value="0" Increment="0.05" FormatString="F2" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- RECORDING TAB -->
            <TabItem Header="{Binding [RAConfig_TabRecording], Source={x:Static loc:LocalizationManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <Border x:Name="Section_RecordingOptions" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_RecordingOptions], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="record_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_record_enable" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="record_output_dir" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_record_output_dir" Grid.Row="1" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="record_config_dir" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_record_config_dir" Grid.Row="2" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="record_use_output_dir" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_record_use_output_dir" Grid.Row="3" Grid.Column="1"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="streaming_mode" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_streaming_mode" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="4" Value="0" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ACCESSIBILITY TAB -->
            <TabItem Header="{Binding [RAConfig_TabAccessibility], Source={x:Static loc:LocalizationManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <Border x:Name="Section_AccessibilityOptions" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_AccessibilityOptions], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="accessibility_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_accessibility_enable" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="accessibility_narrator_speech_speed" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_accessibility_narrator_speech_speed" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="10" Value="5" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Section_AIService" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_AIService], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ai_service_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_ai_service_enable" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="ai_service_mode" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_ai_service_mode" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="2" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="ai_service_url" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <TextBox x:Name="Cfg_ai_service_url" Grid.Row="2" Grid.Column="1" Padding="6,4" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="ai_service_source_lang" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_ai_service_source_lang" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="50" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="ai_service_target_lang" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_ai_service_target_lang" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="50" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="ai_service_pause" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_ai_service_pause" Grid.Row="5" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- MISC / LOGGING / NOTIFICATIONS TAB -->
            <TabItem Header="{Binding [RAConfig_TabMisc], Source={x:Static loc:LocalizationManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <Border x:Name="Section_Logging" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_Logging], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="log_verbosity" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_log_verbosity" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="log_to_file" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_log_to_file" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="log_to_file_timestamp" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_log_to_file_timestamp" Grid.Row="2" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Section_Notifications" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_Notifications], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="notification_show_autoconfig" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_notification_show_autoconfig" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="notification_show_cheats_applied" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_notification_show_cheats_applied" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="notification_show_patch_applied" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_notification_show_patch_applied" Grid.Row="2" Grid.Column="1"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="notification_show_remap_load" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_notification_show_remap_load" Grid.Row="3" Grid.Column="1"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="notification_show_config_override_load" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_notification_show_config_override_load" Grid.Row="4" Grid.Column="1"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="notification_show_set_initial_disk" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_notification_show_set_initial_disk" Grid.Row="5" Grid.Column="1"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="notification_show_fast_forward" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_notification_show_fast_forward" Grid.Row="6" Grid.Column="1"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="notification_show_screenshot" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_notification_show_screenshot" Grid.Row="7" Grid.Column="1"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="notification_show_screenshot_duration" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_notification_show_screenshot_duration" Grid.Row="8" Grid.Column="1" Minimum="0" Maximum="4" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="notification_show_screenshot_flash" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_notification_show_screenshot_flash" Grid.Row="9" Grid.Column="1" Minimum="0" Maximum="4" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="notification_show_refresh_rate" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_notification_show_refresh_rate" Grid.Row="10" Grid.Column="1"/>
                                <TextBlock Grid.Row="11" Grid.Column="0" Text="notification_show_netplay_extra" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_notification_show_netplay_extra" Grid.Row="11" Grid.Column="1"/>
                                <TextBlock Grid.Row="12" Grid.Column="0" Text="notification_show_when_menu_is_alive" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_notification_show_when_menu_is_alive" Grid.Row="12" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Section_MiscOptions" Background="#181825" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [RAConfig_MiscOptions], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="config_save_on_exit" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_config_save_on_exit" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="show_hidden_files" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_show_hidden_files" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="content_history_size" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_content_history_size" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="999" Value="200" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="playlist_sort_alphabetical" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_playlist_sort_alphabetical" Grid.Row="3" Grid.Column="1"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="playlist_compression" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_playlist_compression" Grid.Row="4" Grid.Column="1"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="suspend_screensaver_enable" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_suspend_screensaver_enable" Grid.Row="5" Grid.Column="1"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="fps_show" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_fps_show" Grid.Row="6" Grid.Column="1"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="fps_update_interval" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_fps_update_interval" Grid.Row="7" Grid.Column="1" Minimum="1" Maximum="1024" Value="256" FontSize="12"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="framecount_show" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_framecount_show" Grid.Row="8" Grid.Column="1"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="statistics_show" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_statistics_show" Grid.Row="9" Grid.Column="1"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="game_history_size" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_game_history_size" Grid.Row="10" Grid.Column="1" Minimum="0" Maximum="999" Value="200" FontSize="12"/>
                                <TextBlock Grid.Row="11" Grid.Column="0" Text="memory_show" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_memory_show" Grid.Row="11" Grid.Column="1"/>
                                <TextBlock Grid.Row="12" Grid.Column="0" Text="playlist_entry_rename" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_playlist_entry_rename" Grid.Row="12" Grid.Column="1"/>
                                <TextBlock Grid.Row="13" Grid.Column="0" Text="playlist_entry_remove" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_playlist_entry_remove" Grid.Row="13" Grid.Column="1"/>
                                <TextBlock Grid.Row="14" Grid.Column="0" Text="playlist_use_old_format" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_playlist_use_old_format" Grid.Row="14" Grid.Column="1"/>
                                <TextBlock Grid.Row="15" Grid.Column="0" Text="playlist_sublabel_runtime_type" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_playlist_sublabel_runtime_type" Grid.Row="15" Grid.Column="1" Minimum="0" Maximum="2" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="16" Grid.Column="0" Text="playlist_sublabel_last_played_style" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_playlist_sublabel_last_played_style" Grid.Row="16" Grid.Column="1" Minimum="0" Maximum="5" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="17" Grid.Column="0" Text="playlist_show_sublabels" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_playlist_show_sublabels" Grid.Row="17" Grid.Column="1"/>
                                <TextBlock Grid.Row="18" Grid.Column="0" Text="playlist_show_entry_idx" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_playlist_show_entry_idx" Grid.Row="18" Grid.Column="1"/>
                                <TextBlock Grid.Row="19" Grid.Column="0" Text="playlist_fuzzy_archive_match" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_playlist_fuzzy_archive_match" Grid.Row="19" Grid.Column="1"/>
                                <TextBlock Grid.Row="20" Grid.Column="0" Text="playlist_portable_paths" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_playlist_portable_paths" Grid.Row="20" Grid.Column="1"/>
                                <TextBlock Grid.Row="21" Grid.Column="0" Text="scan_without_core_match" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_scan_without_core_match" Grid.Row="21" Grid.Column="1"/>
                                <TextBlock Grid.Row="22" Grid.Column="0" Text="quit_on_close_content" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <NumericUpDown x:Name="Cfg_quit_on_close_content" Grid.Row="22" Grid.Column="1" Minimum="0" Maximum="2" Value="0" FontSize="12"/>
                                <TextBlock Grid.Row="23" Grid.Column="0" Text="load_dummy_on_core_shutdown" Foreground="#A6ADC8" VerticalAlignment="Center" FontFamily="Consolas,monospace" FontSize="12"/>
                                <CheckBox x:Name="Cfg_load_dummy_on_core_shutdown" Grid.Row="23" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Action Buttons (shown after file loaded) -->
        <StackPanel x:Name="ActionButtons" Orientation="Horizontal" Spacing="8" IsVisible="False">
            <Button x:Name="SaveButton" Content="{Binding [RAConfig_Save], Source={x:Static loc:LocalizationManager.Instance}}"
                    Click="SaveButton_Click" Padding="12,6" IsEnabled="False"/>
            <Button x:Name="SaveAsButton" Content="{Binding [RAConfig_SaveAs], Source={x:Static loc:LocalizationManager.Instance}}"
                    Click="SaveAsButton_Click" Padding="12,6"/>
            <Button x:Name="ResetDefaultsButton" Content="{Binding [RAConfig_ResetDefaults], Source={x:Static loc:LocalizationManager.Instance}}"
                    Click="ResetDefaultsButton_Click" Padding="12,6"/>
            <Button x:Name="CreateNewButton" Content="{Binding [RAConfig_CreateNew], Source={x:Static loc:LocalizationManager.Instance}}"
                    Click="CreateNewButton_Click" Padding="12,6"/>
            <TextBlock x:Name="UnsavedIndicator" Text="{Binding [RAConfig_UnsavedChanges], Source={x:Static loc:LocalizationManager.Instance}}"
                       Foreground="#F9E2AF" FontSize="12" VerticalAlignment="Center" IsVisible="False"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>
